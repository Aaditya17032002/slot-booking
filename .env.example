# Copy to .env. Never commit .env.

USVISA_USERNAME=
USVISA_PASSWORD=
SECURITY_A_PET=
SECURITY_A_FOOD=
SECURITY_A_WORK=

VISA_TYPE=Regular
VISA_CATEGORY=B1/B2
CONSULATES=Kolkata,Mumbai
APPLICANTS=1

POLL_MIN_SECONDS=180
POLL_MAX_SECONDS=420
BACKOFF_BASE_SECONDS=600
BACKOFF_MAX_SECONDS=3600

HEADLESS=false
SLOW_MO_MS=40
BASE_URL=https://www.usvisascheduling.com/en-US/
SCHEDULE_URL=

# cdp = attach to real Chrome (recommended). launch = Playwright browser.
BROWSER_MODE=cdp
CDP_PORT=9222
CHROME_PATH=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EVERY_CHECK=true

STATE_FILE=data/slot_state.json
SESSION_DIR=browser_profile
LOG_LEVEL=INFO
